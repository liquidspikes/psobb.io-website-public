<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Default Document Configuration -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
                <add value="index.html" />
            </files>
        </defaultDocument>

        <!-- Security & Request Filtering: Strictly block database, secrets, and system scripts -->
        <security>
            <requestFiltering>
                <!-- Deny direct HTTP access to critical directories -->
                <hiddenSegments>
                    <add segment="db" />
                    <add segment="config" />
                    <add segment="logs" />
                    <add segment="scratch" />
                    <add segment=".git" />
                </hiddenSegments>

                <!-- Deny direct HTTP access to database files, scripts, and logs -->
                <fileExtensions allowUnlisted="true">
                    <add fileExtension=".db" allowed="false" />
                    <add fileExtension=".env" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                    <add fileExtension=".sh" allowed="false" />
                    <add fileExtension=".bat" allowed="false" />
                    <add fileExtension=".cmd" allowed="false" />
                    <add fileExtension=".ps1" allowed="false" />
                    <add fileExtension=".py" allowed="false" />
                    <add fileExtension=".sql" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>

        <!-- URL Rewrite Rules for Windows IIS -->
        <rewrite>
            <rules>
                <!-- Block access to hidden dotfiles (e.g. .env, .git) -->
                <rule name="Block DotFiles" stopProcessing="true">
                    <match url="^\..*" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Direct access to configuration dotfiles is forbidden." />
                </rule>

                <!-- Block direct access to database files -->
                <rule name="Block Database Files" stopProcessing="true">
                    <match url="(\.db|\.sqlite|\.sqlite3)$" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access to database files is forbidden." />
                </rule>

                <!-- Clean URLs: Externally redirect /file.php to /file (GET only) -->
                <rule name="RedirectPHP" stopProcessing="true">
                    <match url="^(.*)\.php$" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_METHOD}" pattern="^POST$" negate="true" />
                    </conditions>
                    <action type="Redirect" url="{R:1}" redirectType="Permanent" />
                </rule>

                <!-- Clean URLs: Internally rewrite /file to /file.php if file exists -->
                <rule name="RewritePHP" stopProcessing="true">
                    <match url="^([^.]+)$" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{DOCUMENT_ROOT}/{R:1}.php" matchType="IsFile" />
                    </conditions>
                    <action type="Rewrite" url="{R:1}.php" />
                </rule>
            </rules>
        </rewrite>

        <!-- Static content MIME mappings for modern web assets -->
        <staticContent>
            <remove fileExtension=".woff" />
            <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
        </staticContent>

        <!-- Directory Browsing Disabled -->
        <directoryBrowse enabled="false" />
    </system.webServer>
</configuration>
