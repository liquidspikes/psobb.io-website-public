# ==============================================================================
# PSOBB Website Environment Configuration (.env)
# ==============================================================================
# 
# ⚠️ ARCHITECTURAL RULE: WHAT GOES HERE VS. WHAT GOES IN config/
# ------------------------------------------------------------------------------
# 1. WHAT BELONGS IN .env:
#    - SENSITIVE SECRETS: API keys, client secrets, bot tokens, passwords.
#    - HOST-SPECIFIC INFRASTRUCTURE: Local ports, internal IP addresses, 
#      and deployment callbacks that vary between dev, staging, and production.
#    - SECURITY: This file contains private credentials and MUST NEVER be 
#      committed to version control (.gitignore).
#
# 2. WHAT BELONGS IN config/ (e.g., config/theme.json):
#    - PRESENTATION & BRANDING: Theme presets (Pioneer 2, Cyberpunk, Forest, etc.),
#      custom CSS color palettes, UI toggles, and public links (e.g., Discord invite).
#    - ADMIN-EDITABLE: These settings can be safely committed to git as defaults
#      and dynamically modified at runtime by Server Admins via /admin/theme_manager.php.
#
# ------------------------------------------------------------------------------
# SETUP:
# Copy this file to `.env` in the site root:
#   cp .env.example .env
# ==============================================================================

# ==============================================================================
# 1. GAME SERVER (NewServ) INTEGRATION
# ==============================================================================
# The base URL to your NewServ REST API instance (private local network / localhost)
NEWSERV_API_URL="http://127.0.0.1:8443"

# Absolute path to NewServ's system/players directory containing .psochar / .psobank files.
# Examples:
#   Linux VPS:   NEWSERV_PLAYERS_DIR="/opt/newserv/system/players"
#   Windows:     NEWSERV_PLAYERS_DIR="C:/OSPanel/home/psobb.ru/newserv/system/players"
NEWSERV_PLAYERS_DIR="/opt/newserv/system/players"

# The command prefix your server uses for client commands (e.g., $, /, ?)
NEWSERV_COMMAND_PREFIX="$"

# ==============================================================================
# 2. SERVER BRANDING & IDENTITY (Optional overrides for config/site.json)
# ==============================================================================
# Server brand name displayed in titles, emails, and header
SERVER_NAME="PSOBB.IO"

# Server domain address (without protocol or slashes)
SERVER_ADDRESS="psobb.io"

# Server descriptive tagline
SERVER_TAGLINE="Join the adventure in the ultimate private Phantasy Star Online BlueBurst server experience."

# ==============================================================================
# 2. DISCORD OAUTH2 (Player Account Linking)
# ==============================================================================
# Created in the Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_CLIENT_ID="your_discord_client_id_here"
DISCORD_CLIENT_SECRET="your_discord_client_secret_here"

# The exact OAuth2 Redirect URI configured in your Discord Developer Application
DISCORD_REDIRECT_URI="https://yourdomain.com/api/discord_callback.php"

# ==============================================================================
# 3. DISCORD BOT & AUTOMATION
# ==============================================================================
# Legacy shared secret for internal bot API communications (api/bot_api.php)
BOT_API_SECRET=""

# Discord Bot Token (used by cron_streak_alert.php to send automated DM alerts)
BOT_TOKEN=""

# ==============================================================================
# 4. EXTERNAL AI INTEGRATIONS (Bounties & Community Events)
# ==============================================================================
# Google Gemini API key used by cron scripts to generate procedural missions
GEMINI_API_KEY="your_gemini_api_key_here"

# Model identifier (e.g., gemini-3.5-flash, gemini-2.5-flash)
GEMINI_MODEL="gemini-3.5-flash"

# ==============================================================================
# 5. TRANSACTIONAL EMAIL (Account Recovery & Verification)
# ==============================================================================
# Brevo (formerly Sendinblue) API key for sending verification and password reset emails.
# Leave empty if using local sendmail/SMTP relay.
BREVO_API_KEY=""

# The sender email address displayed on outgoing messages
SMTP_FROM="noreply@psobb.io"

# ==============================================================================
# 6. OPTIONAL HOST OVERRIDES FOR PUBLIC SETTINGS
# ==============================================================================
# NOTE: Public site links and visual themes are normally managed via config/theme.json 
# and the Admin Theme Manager UI (/admin/theme_manager.php).
# However, if you want this specific host environment to enforce a Discord link via .env:
# DISCORD_SERVER="https://discord.gg/your-invite-code"
