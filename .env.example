# ==============================================================================
# PSOBB Web Portal — Environment Configuration Baseline (.env.example)
# ==============================================================================
# 
# ⚠️ ARCHITECTURAL OVERVIEW: WHAT GOES HERE VS. WHAT GOES IN config/
# ------------------------------------------------------------------------------
# 1. WHAT BELONGS IN .env:
#    - SENSITIVE SECRETS: API keys, client secrets, bot tokens, passwords.
#    - HOST-SPECIFIC INFRASTRUCTURE: Local ports, internal IP addresses, local
#      filesystem paths, and deployment callbacks that vary between dev, staging,
#      and production environments.
#    - SECURITY: This file contains private credentials and MUST NEVER be 
#      committed to version control (.gitignore).
#
# 2. WHAT BELONGS IN config/ (e.g., config/site.json, config/theme.json):
#    - PRESENTATION & BRANDING: Server name, tagline, theme presets, colors,
#      public community links, and feature module toggles.
#    - ADMIN-EDITABLE: Settings can be modified live by Server Admins via 
#      the Web Admin UI (/admin/site_settings.php, /admin/theme_manager.php).
#    - REPOSITORY BASELINES: Safe to commit default baselines to Git.
#
# ------------------------------------------------------------------------------
# SETUP:
# Copy this file to `.env` in the website root:
#   cp .env.example .env
# ==============================================================================

# ==============================================================================
# 1. GAME SERVER (NewServ) INTEGRATION
# ==============================================================================

# Base URL to your NewServ REST API instance.
# NewServ runs an internal HTTP server that reports server telemetry, active clients,
# lobbies, and handles shell-exec commands.
# Type: string (HTTP URL)
# Default: "http://127.0.0.1:8443"
# Examples:
#   Linux / Local:       NEWSERV_API_URL="http://127.0.0.1:8443"
#   Docker Container:    NEWSERV_API_URL="http://newserv:8443"
#   LAN Server:          NEWSERV_API_URL="http://192.168.1.100:8443"
NEWSERV_API_URL="http://127.0.0.1:8443"

# Absolute path to NewServ's system/players directory.
# The portal reads player save files (.psochar) for offline character slots,
# offline material reset, character inspection/download, and shared bank (.psobank).
# Type: string (Absolute filesystem path)
# Default: "/opt/newserv/system/players"
# Examples:
#   Linux VPS (Default): NEWSERV_PLAYERS_DIR="/opt/newserv/system/players"
#   Linux Local Build:   NEWSERV_PLAYERS_DIR="/home/user/newserv/system/players"
#   Windows OpenServer:  NEWSERV_PLAYERS_DIR="C:/OSPanel/home/psobb.ru/newserv/system/players"
#   Windows Standalone:  NEWSERV_PLAYERS_DIR="C:/newserv/system/players"
#   Docker Volume Mount: NEWSERV_PLAYERS_DIR="/var/newserv/system/players"
NEWSERV_PLAYERS_DIR="/opt/newserv/system/players"

# In-game chat command prefix used by NewServ (must match newserv system/config.json).
# Type: string
# Default: "$"
# Examples:
#   Standard:            NEWSERV_COMMAND_PREFIX="$"
#   Slash command:       NEWSERV_COMMAND_PREFIX="/"
#   Exclamation:         NEWSERV_COMMAND_PREFIX="!"
NEWSERV_COMMAND_PREFIX="$"


# ==============================================================================
# 2. SERVER BRANDING & IDENTITY (Optional Environment Overrides)
# ==============================================================================
# Note: These values can also be managed via config/site.json and the Web Admin UI.
# Setting them here overrides config/site.json for this specific host environment.

# Public brand name of your game server.
# Displayed in titles, navigation bar, transactional emails, and page headers.
# Type: string
# Default: "PSOBB.IO"
# Examples:
#   International:       SERVER_NAME="PSOBB.IO"
#   Russian Community:   SERVER_NAME="PSOBB.RU"
#   Custom Name:         SERVER_NAME="Pioneer 2 Destiny"
SERVER_NAME="PSOBB.IO"

# Primary domain or hostname for the server (without protocol 'http://' or slashes).
# Used to construct confirmation links, password reset links, and connect instructions.
# Type: string
# Default: "psobb.io"
# Examples:
#   Production:          SERVER_ADDRESS="psobb.io"
#   Regional:            SERVER_ADDRESS="psobb.ru"
#   Local Development:   SERVER_ADDRESS="localhost:8000"
#   LAN IP:              SERVER_ADDRESS="192.168.1.50"
SERVER_ADDRESS="psobb.io"

# Descriptive tagline displayed on the homepage hero banner and meta tags.
# Type: string
# Examples:
#   English Default:     SERVER_TAGLINE="Join the adventure in the ultimate private Phantasy Star Online BlueBurst server experience."
#   Russian:             SERVER_TAGLINE="Возрождение легендарной PSOBB в русскоязычном сообществе."
#   Custom:              SERVER_TAGLINE="Classic 2004 nostalgia reimagined with modern web services and quality of life."
SERVER_TAGLINE="Join the adventure in the ultimate private Phantasy Star Online BlueBurst server experience."

# Displayed game multipliers (informational badges on homepage & stats).
# Type: string
# Examples: "1x", "2x", "5x", "Dynamic Weekend Boost"
EXP_RATE="1x"
DROP_RATE="1x"
MESETA_RATE="1x"


# ==============================================================================
# 3. DISCORD OAUTH2 (Player Account Linking)
# ==============================================================================
# Allows players to securely link their Discord identity to their PSOBB game account.
# Obtain these credentials from the Discord Developer Portal (https://discord.com/developers/applications).

# Application Client ID from Discord Developer Portal.
# Type: string (Numeric snowflake)
# Example: DISCORD_CLIENT_ID="120987654321098765"
DISCORD_CLIENT_ID=""

# Application Client Secret from Discord Developer Portal.
# Type: string (Confidential string)
# Example: DISCORD_CLIENT_SECRET="aB1cD2eF3gH4iJ5kL6mN7oP8qR9sT0uV"
DISCORD_CLIENT_SECRET=""

# Exact OAuth2 Redirect URI configured in your Discord Application settings.
# Must match character-for-character including protocol (https://).
# Type: string (Full URL)
# Examples:
#   Production:          DISCORD_REDIRECT_URI="https://psobb.io/api/discord_callback.php"
#   Russian Domain:      DISCORD_REDIRECT_URI="https://psobb.ru/api/discord_callback.php"
#   Local Testing:       DISCORD_REDIRECT_URI="http://localhost:8000/api/discord_callback.php"
DISCORD_REDIRECT_URI="https://psobb.io/api/discord_callback.php"


# ==============================================================================
# 4. DISCORD BOT & AUTOMATION
# ==============================================================================

# Shared bearer secret used for bot API communication (/api/bot_api.php).
# Type: string (Random hex / token)
# Example: BOT_API_SECRET="sec_9e2f4a1c7b8d0e3f5a6b7c8d9e0f1a2b"
BOT_API_SECRET=""

# Discord Bot Token used by automated cron scripts (e.g. cron_streak_alert.php).
# Enables sending automated direct messages for daily streaks and milestones.
# Type: string (Discord bot token)
# Example: BOT_TOKEN="your_discord_bot_token_here"
BOT_TOKEN=""

# Public Discord invite URL for community buttons across the portal.
# Type: string (URL)
# Examples:
#   Main Community:      DISCORD_SERVER="https://discord.gg/28s84HJXha"
#   Custom Vanity:       DISCORD_SERVER="https://discord.gg/your-invite-code"
DISCORD_SERVER="https://discord.gg/28s84HJXha"

# Discord Guild / Server ID (optional, used for member verification or widgets).
# Type: string (Numeric snowflake)
# Example: DISCORD_SERVER_ID="112233445566778899"
DISCORD_SERVER_ID=""


# ==============================================================================
# 5. EXTERNAL AI INTEGRATIONS (Bounties, Missions & Events)
# ==============================================================================

# Google Gemini API key used by cron scripts to generate procedural Hunter Guild bounties.
# Leave empty if you do not use procedural AI missions.
# Type: string
# Example: GEMINI_API_KEY="AIzaSyA1B2C3D4E5F6G7H8I9J0K1L2M3N4O5P6Q"
GEMINI_API_KEY=""

# Gemini model identifier.
# Type: string
# Examples:
#   Recommended:         GEMINI_MODEL="gemini-2.5-flash"
#   Alternative:         GEMINI_MODEL="gemini-3.5-flash"
GEMINI_MODEL="gemini-2.5-flash"


# ==============================================================================
# 6. TRANSACTIONAL EMAIL (Account Recovery, Verification & Security Alerts)
# ==============================================================================

# Brevo (formerly Sendinblue) REST API key for sending transactional emails.
# If left empty, the site falls back to PHP mail() / local sendmail or SMTP relay.
# Type: string
# Example: BREVO_API_KEY="xkeysib-a1b2c3d4e5f6-7890abcdef"
BREVO_API_KEY=""

# Sender email address displayed on outgoing verification and password reset emails.
# Type: string (Email address)
# Examples:
#   Production:          SMTP_FROM="noreply@psobb.io"
#   Regional:            SMTP_FROM="support@psobb.ru"
#   Admin:               SMTP_FROM="admin@yourserver.org"
SMTP_FROM="noreply@psobb.io"


# ==============================================================================
# 7. FEATURE FLAGS (Optional Modular Overrides)
# ==============================================================================
# Toggle site features on or off. Can also be toggled in config/site.json.
# Type: boolean ("true" | "false")
# Examples:
#   ENABLE_REGISTRATION="true"
#   ENABLE_BOUNTIES="true"
#   ENABLE_LFG="true"
#   ENABLE_MODS="true"
#   ENABLE_QUEST_EDITOR="true"
#   ENABLE_DISCORD_OAUTH="true"
